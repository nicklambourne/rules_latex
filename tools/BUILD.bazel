# Python implementation code and developer-facing helpers.
#
# Nothing under this package is part of the public rules_latex API.

load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

# Six scripts and shared libraries that drive the rules_latex
# tectonic action paths and the live-preview server:
#
#   - staging.py: shared layout logic (main-rooted staging).
#   - tectonic_populate_cache.py: TectonicPopulateCache action wrapper
#     and the worker behind `latex_cache_snapshot`.
#   - tectonic_compile.py: TectonicCompile action wrapper.
#   - serve_cache.py: serve-time persistent cache manager imported
#     by the generated `latex_live` server script. See
#     latex/private/serve_web.py.tpl for how it's wired in.
#   - pdf_chunks.py: cross-reference-stream-aware PDF chunker
#     used by the serve script to content-address the compiled
#     PDF's indirect objects, so the browser only re-fetches the
#     chunks that actually changed between rebuilds.
#   - ws_server.py: RFC 6455 stdlib WebSocket server, consumed by
#     the live-preview server to push PDF chunks proactively after
#     each rebuild. Stdlib-only, no third-party deps. See
#     tests/py/test_ws_server.py for protocol coverage.
#
# The source files remain exported because latex_live loads several modules
# dynamically from its runfiles. Production actions use the executable
# targets below once their rule plumbing is migrated.
exports_files([
    "staging.py",
    "tectonic_populate_cache.py",
    "tectonic_compile.py",
    "serve_cache.py",
    "pdf_chunks.py",
    "ws_server.py",
])

_PYTHON_VERSION = "3.13"

# The script bootstrap launches the in-build runtime directly. The default
# system_python bootstrap would still require python3 on PATH before it could
# reach the hermetic interpreter.
_HERMETIC_CONFIG = {
    "@rules_python//python/config_settings:bootstrap_impl": "script",
}

py_library(
    name = "staging",
    srcs = ["staging.py"],
)

py_library(
    name = "serve_cache",
    srcs = ["serve_cache.py"],
)

py_library(
    name = "pdf_chunks",
    srcs = ["pdf_chunks.py"],
)

py_library(
    name = "ws_server",
    srcs = ["ws_server.py"],
)

py_binary(
    name = "tectonic_compile",
    srcs = ["tectonic_compile.py"],
    config_settings = _HERMETIC_CONFIG,
    legacy_create_init = 0,
    python_version = _PYTHON_VERSION,
    deps = [":staging"],
)

py_binary(
    name = "tectonic_populate_cache",
    srcs = ["tectonic_populate_cache.py"],
    config_settings = _HERMETIC_CONFIG,
    legacy_create_init = 0,
    python_version = _PYTHON_VERSION,
    deps = [":staging"],
)

py_binary(
    name = "extract_bundle_manifest",
    srcs = ["extract_bundle_manifest.py"],
    config_settings = _HERMETIC_CONFIG,
    legacy_create_init = 0,
    python_version = _PYTHON_VERSION,
)

py_binary(
    name = "python_runner",
    srcs = ["python_runner.py"],
    config_settings = _HERMETIC_CONFIG,
    legacy_create_init = 0,
    python_version = _PYTHON_VERSION,
)
