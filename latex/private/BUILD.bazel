# Private implementation details. Do not load from outside //latex/*.

package(default_visibility = ["//latex:__subpackages__"])

exports_files(
    glob([
        "*.bzl",
        "*.py.tpl",
        # serve_web client assets: extracted from serve_web.py.tpl so
        # they can be unit-tested under //tests/js with `node --test`.
        "*.js",
        "*.css",
    ]),
)

# Live-preview client assets, served at /_assets/ by latex_live.
# Globbed so new pure-logic modules are picked up without touching the
# rule. Pure modules are unit-tested under //tests/js.
filegroup(
    name = "serve_web_client_assets",
    srcs = glob(["serve_web*.js"]) + ["serve_web.css"],
)
