package(default_visibility = ["//visibility:public"])

# Toolchain type that all latex actions resolve against.
toolchain_type(
    name = "toolchain_type",
)

exports_files([
    "toolchain.bzl",
    "repositories.bzl",
    "extensions.bzl",
    # Bundle-resident package manifest, consulted by the CTAN
    # auto-resolver in tools/tectonic_populate_cache.py.
    # Generated by tools/extract_bundle_manifest.py; refresh
    # whenever the pinned tectonic bundle changes.
    "bundle_manifest.txt",
])
