"""Integration tests for CTAN package support in rules_latex.

These tests verify that ctan_packages works correctly with the
implicit cache pipeline, including:

  * Fetching a simple CTAN package (lipsum)
  * The auto-resolver discovering and fetching a transitive CTAN
    dep that the user didn't list, and the fetched files actually
    being consumed by tectonic via -Z search-path
"""

load(
    "//latex:defs.bzl",
    "latex_cache_snapshot",
    "latex_document",
    "latex_test",
)

# ---------------------------------------------------------------------------
# Test 1: Simple CTAN package (lipsum)
# ---------------------------------------------------------------------------

latex_document(
    name = "lipsum_doc",
    srcs = ["lipsum_test.tex"],
    ctan_packages = ["lipsum"],
    main = "lipsum_test.tex",
    tags = ["manual"],
)

latex_test(
    name = "lipsum_compiles_test",
    srcs = ["lipsum_test.tex"],
    ctan_packages = ["lipsum"],
    main = "lipsum_test.tex",
)

# ---------------------------------------------------------------------------
# Test 2: Auto-resolver discovers and consumes a transitive CTAN dep
# ---------------------------------------------------------------------------
#
# test-pkg-a is a synthetic CTAN package (lives only in
# tests/ctan/fixtures/, not on real CTAN) whose .sty does
# \RequirePackage{test-pkg-b}. test-pkg-b is also synthetic and
# only available via the fixture mirror.
#
# We list only test-pkg-a in ctan_packages. The test passes iff:
#   * test-pkg-a is fetched
#   * its .sty is scanned, test-pkg-b is discovered as an upstream ref
#   * test-pkg-b is HEAD-probed (200 on the fixture mirror) and fetched
#   * tectonic compiles the .tex, finding both .sty files via the
#     -Z search-path flags added by tools/tectonic_populate_cache.py
#
# This replaces an earlier biblatex_apa_compiles_test that was
# passing by accident (fetched files weren't actually consumed by
# tectonic; the bundled apa.bbx was loaded instead). See
# docs/site/getting-started/ctan-packages.md "Limitations" for why
# biblatex extension styles can't be tested this way.
#
# Requires RULES_LATEX_CTAN_MIRROR to point at the local fixture
# server (set by the CI workflow via --test_env).

latex_test(
    name = "transitive_resolve_test",
    srcs = ["transitive_resolve_test.tex"],
    ctan_packages = ["test-pkg-a"],  # NOT test-pkg-b — must be auto-resolved
    main = "transitive_resolve_test.tex",
    # Sanity-check both fetched packages actually got loaded.
    # If only test-pkg-a appeared, the resolver didn't follow
    # the transitive ref; if neither did, search-path isn't wired up.
    required_patterns = [
        "test-pkg-a.sty",
        "test-pkg-b.sty",
    ],
)

# ---------------------------------------------------------------------------
# Test 3: Cache snapshot with CTAN packages (manual - requires running bazel run)
latex_cache_snapshot(
    name = "lipsum_cache",
    srcs = ["lipsum_test.tex"],
    ctan_packages = ["lipsum"],
    main = "lipsum_test.tex",
    output = "lipsum_cache.tar.gz",
    tags = ["manual"],
)

test_suite(
    name = "ctan_tests",
    tests = [
        ":lipsum_compiles_test",
        ":transitive_resolve_test",
    ],
)
