"""Minimal hello-world LaTeX document.

The simplest possible rules_latex usage: a single .tex file, a tiny
shared preamble, and a target that compiles them. Also demonstrates
the reproducible mode, the manual cache snapshot path, the live
preview rule, and the latex_test regression-testing rule.

For real-world document shapes (letter, CV, paper, thesis, beamer)
see the sibling example directories.
"""

load(
    "@rules_latex//latex:defs.bzl",
    "latex_cache_snapshot",
    "latex_document",
    "latex_library",
    "latex_live",
    "latex_test",
)

# A tiny helper library with a shared preamble.
latex_library(
    name = "preamble",
    srcs = ["preamble.tex"],
)

# A minimal "hello, world" document that uses the helper library above.
latex_document(
    name = "hello",
    srcs = ["hello.tex"],
    main = "hello.tex",
    visibility = ["//visibility:public"],
    deps = [":preamble"],
)

# Same document, but built deterministically: identical inputs produce
# byte-identical output.
latex_document(
    name = "hello_reproducible",
    srcs = ["hello.tex"],
    main = "hello.tex",
    reproducible = True,
    deps = [":preamble"],
)

# Same document, built fully offline against a small (~10 MB) cache
# snapshot. The snapshot tarball is produced once by `bazel run
# //hello:hello_snapshot` (requires internet) and checked into the
# repo; every subsequent build is hermetic and skips the implicit
# cache pipeline entirely.
latex_document(
    name = "hello_offline",
    srcs = ["hello.tex"],
    cache = "hello_cache.tar.gz",
    main = "hello.tex",
    deps = [":preamble"],
)

# Developer command: refresh the cache snapshot. Run with:
#     bazel run //hello:hello_snapshot
latex_cache_snapshot(
    name = "hello_snapshot",
    srcs = ["hello.tex"],
    main = "hello.tex",
    output = "hello/hello_cache.tar.gz",
    deps = [":preamble"],
)

# In-browser live-preview workflow: http://127.0.0.1:8765/
# Edits to hello.tex rebuild the document and push the changed PDF
# chunks to the browser tab over WebSocket. Includes page nav,
# in-doc search, outline sidebar, build-log drawer, and a
# light/dark theme toggle.
latex_live(
    name = "hello_live",
    document = ":hello_offline",
)

# Same document built with synctex output, wired into a serve target
# so clicking in the rendered PDF copies the corresponding source
# location. Editors can also send a source location to the preview.
latex_document(
    name = "hello_synctex",
    srcs = ["hello.tex"],
    cache = "hello_cache.tar.gz",
    main = "hello.tex",
    synctex = True,
    deps = [":preamble"],
)

latex_live(
    name = "hello_synctex_live",
    document = ":hello_synctex",
    port = 8766,
)

# Regression test: compile hello.tex and assert no LaTeX errors in the
# log. Uses the checked-in snapshot so it runs offline and finishes in
# ~3 seconds.
latex_test(
    name = "hello_compiles",
    srcs = ["hello.tex"],
    cache = "hello_cache.tar.gz",
    main = "hello.tex",
    deps = [":preamble"],
)

# One input set through all four public consumers: an external module's
# latex_library plus a generated source staged at explicit paths.
genrule(
    name = "generated_fragment",
    outs = ["generated.tex"],
    cmd = "echo 'Generated source reached.' > $@",
)

latex_library(
    name = "generated_library",
    srcs = [":generated_fragment"],
)

_CONTRACT_SRCS = ["contract.tex"]

_CONTRACT_DEPS = [
    ":generated_library",
    "@rules_latex_contract_fixture//:external_fragment",
]

_CONTRACT_PKG_FILES = {
    ":generated_fragment": "generated.tex",
    "@rules_latex_contract_fixture//:external.tex": "external.tex",
}

latex_document(
    name = "contract_document",
    srcs = _CONTRACT_SRCS,
    cache = "hello_cache.tar.gz",
    main = "contract.tex",
    pkg_files = _CONTRACT_PKG_FILES,
    deps = _CONTRACT_DEPS,
)

latex_test(
    name = "contract_test",
    srcs = _CONTRACT_SRCS,
    cache = "hello_cache.tar.gz",
    main = "contract.tex",
    pkg_files = _CONTRACT_PKG_FILES,
    deps = _CONTRACT_DEPS,
)

latex_cache_snapshot(
    name = "contract_snapshot",
    srcs = _CONTRACT_SRCS,
    main = "contract.tex",
    output = "hello/contract_cache.tar.gz",
    pkg_files = _CONTRACT_PKG_FILES,
    deps = _CONTRACT_DEPS,
)

latex_live(
    name = "contract_live",
    document = ":contract_document",
    open_on_start = False,
    port = 8771,
)
