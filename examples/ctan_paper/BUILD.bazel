"""KNOWN BROKEN: a paper using a CTAN bibliography style not in the
Tectonic bundle.

This example was originally written to demonstrate
`ctan_packages = ["biblatex-apa"]`. It currently fails: the fetched
biblatex-apa 9.20 requires biblatex 3.18+, but the bundle ships
biblatex 3.17 / biber 2.17 (DESIGN.md §4.10). The mismatch surfaces
as:

    error: apa.bbx:258: Undefined control sequence

For the canonical explanation see the "Limitations" section in
docs/site/getting-started/ctan-packages.md. Modern biblatex support
is gated on a fresh upstream bundle
(https://github.com/nicklambourne/rules_latex/issues/1).

The targets are tagged `manual` so wildcard builds (`bazel build
//...`) skip them. The files are kept as a historical reference and
as the seed for a future working example once the bundle bumps.
"""

load("@rules_latex//latex:defs.bzl", "latex_document", "latex_test")

latex_document(
    name = "ctan_paper",
    srcs = [
        "paper.tex",
        "references.bib",
    ],
    biber = True,
    ctan_packages = ["biblatex-apa"],
    main = "paper.tex",
    tags = ["manual"],  # known broken; see docstring at top of file
    visibility = ["//visibility:public"],
)

latex_test(
    name = "ctan_paper_compiles",
    srcs = [
        "paper.tex",
        "references.bib",
    ],
    biber = True,
    ctan_packages = ["biblatex-apa"],
    main = "paper.tex",
    # Confirms biblatex-apa actually loaded (not just silently
    # falling back to a default style).
    required_patterns = ["apa"],
    tags = ["manual"],  # known broken; see docstring at top of file
)
